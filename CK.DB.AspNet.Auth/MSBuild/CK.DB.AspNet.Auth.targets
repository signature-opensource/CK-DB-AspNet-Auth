<Project>
  <Target Name="CK_DB_AspNet_Auth_IsDeprecated" BeforeTargets="ResolveAssemblyReferences">
    <Error Code="CKDEPRECATED"
           Text="Package 'CK.DB.AspNet.Auth' is deprecated and must be replaced by 'CK.AppIdentity.Cris.AuthCenter.Local': see https://github.com/signature-opensource/CK-AppIdentity-Transport/blob/stable/CK.AppIdentity.Cris.AuthCenter.Local/README.md and the migration guide https://github.com/signature-opensource/CK-Stack/blob/main/Docs/Migrations/v2026.282-to-explo-cris-auth.md." />
  </Target>
</Project>
